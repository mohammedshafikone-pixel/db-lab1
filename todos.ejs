<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My To-Do List</title>

    <link rel="stylesheet" href="/style.css">
    <script src="/script.js" defer></script>
</head>

<body>

    <div class="todo-container">

        <header class="topbar">

            <div>
                <h1>My To-Do List</h1>

                <p>Welcome, <%= userName %>!</p>
            </div>

            <form action="/logout" method="POST">
                <button type="submit" class="logout-btn">
                    Logout
                </button>
            </form>

        </header>

        <% if (errors.length > 0) { %>
            <div class="errors">
                <% errors.forEach(error => { %>
                    <p><%= error %></p>
                <% }) %>
            </div>
        <% } %>

        <form action="/todos/add" method="POST" id="todoForm">

            <label for="title">What needs to be done?</label>

            <div class="add-row">

                <input
                    type="text"
                    id="title"
                    name="title"
                    maxlength="200"
                    placeholder="Enter a new task..."
                >

                <button type="submit">Add</button>

            </div>

        </form>

        <h2>Your Tasks</h2>

        <% if (todos.length === 0) { %>

            <p class="empty-message">
                No tasks yet. Add your first task!
            </p>

        <% } else { %>

            <div class="task-list">

                <% todos.forEach(todo => { %>

                    <div class="task <%= todo.is_done ? 'completed' : '' %>">

                        <form
                            action="/todos/toggle/<%= todo.todo_id %>"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="check-btn"
                                aria-label="Toggle task completion"
                            >
                                <%= todo.is_done ? '✓' : '○' %>
                            </button>
                        </form>

                        <form
                            action="/todos/edit/<%= todo.todo_id %>"
                            method="POST"
                            class="edit-form"
                        >

                            <input
                                type="text"
                                name="title"
                                value="<%= todo.title %>"
                                maxlength="200"
                                aria-label="Edit task title"
                            >

                            <button type="submit" class="save-btn">
                                Save
                            </button>

                        </form>

                        <form
                            action="/todos/delete/<%= todo.todo_id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this task?')"
                        >
                            <button type="submit" class="delete-btn">
                                Delete
                            </button>
                        </form>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</body>
</html>